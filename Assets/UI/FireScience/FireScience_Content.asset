  categories:
  - title: "\u706B\u707E\u5E38\u8BC6"
    intro: "\u8BA4\u8BC6\u706B\u707E\u4E0E\u6D53\u70DF\uFF0C\u624D\u80FD\u5728\u706B\u573A\u505A\u51FA\u6B63\u786E\u5224\u65AD\u3002"
    cards:
    - heading: "\u706B\u707E\u53D1\u5C55\u7684\u4E09\u4E2A\u9636\u6BB5"
      body: "\u706B\u707E\u53D1\u5C55\u5206\u4E3A\u4E09\u4E2A\u9636\u6BB5\uFF1A\n\u521D\u671F\u2014\u2014\u8D77\u706B\u540E\u7684\u5934\u51E0\u5206\u949F\uFF0C\u706B\u52BF\u5C0F\u3001\u70DF\u5C11\uFF0C\u662F\u6251\u6551\u4E0E\u9003\u751F\u7684\u9EC4\u91D1\u7A97\u53E3\uFF1B\n\u53D1\u5C55\u671F\u2014\u2014\u706B\u52BF\u8FC5\u901F\u8513\u5EF6\uFF0C\u5904\u7F6E\u7A97\u53E3\u5FEB\u901F\u5173\u95ED\uFF1B\n\u731B\u70C8\u671F\u2014\u2014\u5DF2\u65E0\u6CD5\u6251\u6551\uFF0C\u53EA\u80FD\u7ACB\u5373\u64A4\u79BB\u3002\n\u5BBF\u820D\u63D2\u7EBF\u677F\u8D77\u706B\u5C31\u5C5E\u4E8E\u521D\u671F\u706B\uFF0C\u6B64\u65F6\u5904\u7F6E\u5F97\u5F53\u5B8C\u5168\u53EF\u4EE5\u6251\u706D\u3002"
      practice: "\u5BBF\u820D\u5173\uFF1A\u82CF\u9192\u540E\u7ACB\u5373\u5904\u7F6E\u63D2\u7EBF\u677F\u521D\u671F\u706B\uFF0C\u7528\u706D\u706B\u5668\u5373\u53EF\u6251\u706D"
      illustration: {fileID: 21300000, guid: 09a563874ec91324b9f135453f7e5845, type: 3}
    - heading: "\u6D53\u70DF\u662F\u706B\u573A\u7B2C\u4E00\u6740\u624B"
      body: "\u706B\u707E\u9047\u96BE\u8005\u4E2D\u591A\u6570\u6B7B\u4E8E\u70DF\u6C14\u4E2D\u6BD2\u4E0E\u7A92\u606F\uFF0C\u800C\u975E\u70E7\u4F24\u3002\u70DF\u6C14\u4E2D\u542B\u4E00\u6C27\u5316\u78B3\u7B49\u6709\u6BD2\u6C14\u4F53\uFF0C\u540C\u65F6\u5177\u6709\u9AD8\u6E29\u5E76\u4E25\u91CD\u906E\u6321\u89C6\u7EBF\u2014\u2014\u4E09\u91CD\u5A01\u80C1\u53E0\u52A0\uFF0C\u5F80\u5F80\u51E0\u5341\u79D2\u5C31\u80FD\u8BA9\u4EBA\u5931\u53BB\u884C\u52A8\u80FD\u529B\u3002"
      practice: 
      illustration: {fileID: 0}
    - heading: "\u70DF\u5728\u4E0A\u3001\u4EBA\u5728\u4E0B"
      body: "\u70DF\u6C14\u53D7\u70ED\u540E\u5411\u4E0A\u6F02\u6D6E\uFF0C\u8D34\u8FD1\u5730\u9762\u7684\u7A7A\u6C14\u76F8\u5BF9\u66F4\u6E05\u6D01\u3001\u6E29\u5EA6\u66F4\u4F4E\u2014\u2014\u8FD9\u6B63\u662F\u201C\u4F4E\u59FF\u9003\u751F\u201D\u7684\u79D1\u5B66\u4F9D\u636E\u3002\u7A7F\u8FC7\u6D53\u70DF\u533A\u65F6\uFF0C\u5F2F\u8170\u3001\u8E72\u4E0B\u751A\u81F3\u530D\u5310\uFF0C\u80FD\u5927\u5E45\u51CF\u5C11\u5438\u5165\u7684\u6BD2\u70DF\u3002"
      practice: "\u5BBF\u820D\u5173/\u529E\u516C\u697C\u5173\uFF1A\u7AD9\u7ACB\u5373\u6301\u7EED\u6389\u8840\uFF0C\u6309
        Ctrl \u8E72\u4E0B\u540E\u4F24\u5BB3\u9AA4\u51CF"
      illustration: {fileID: 0}
  - title: "\u62A5\u8B66\u6C42\u52A9"
    intro: "\u8D8A\u65E9\u62A5\u8B66\uFF0C\u8D8A\u65E9\u83B7\u5F97\u6551\u63F4\u2014\u2014\u62A5\u8B66\u6C38\u8FDC\u6392\u5728\u6536\u62FE\u8D22\u7269\u4E4B\u524D\u3002"
    cards:
    - heading: "\u5C31\u8FD1\u62A5\u8B66\u7B2C\u4E00\u65F6\u95F4"
      body: "\u53D1\u73B0\u706B\u60C5\u7B2C\u4E00\u65F6\u95F4\u5927\u58F0\u793A\u8B66\uFF0C\u901A\u77E5\u5468\u56F4\u7684\u4EBA\uFF0C\u5E76\u5C31\u8FD1\u6309\u4E0B\u624B\u52A8\u706B\u707E\u62A5\u8B66\u6309\u94AE\u3002\u62A5\u8B66\u8D8A\u65E9\uFF0C\u6551\u63F4\u8D8A\u65E9\u5230\uFF1B\u8D22\u7269\u53EF\u4EE5\u518D\u6323\uFF0C\u751F\u547D\u53EA\u6709\u4E00\u6B21\u3002"
      practice: 
      illustration: {fileID: 21300000, guid: c9a28cdfdb0dab14ba9f34ee85f938bf, type: 3}
    - heading: "\u62E8\u6253 119 \u56DB\u8981\u7D20"
      body: "\u62E8\u6253\u706B\u8B66\u7535\u8BDD\u8981\u8BB2\u6E05\u56DB\u70B9\uFF1A\u8BE6\u7EC6\u5730\u5740\u3001\u8D77\u706B\u7269\u3001\u706B\u52BF\u5927\u5C0F\u3001\u6709\u65E0\u88AB\u56F0\u4EBA\u5458\u3002\u4E0D\u8981\u5148\u6302\u65AD\uFF0C\u7B49\u63A5\u8B66\u5458\u793A\u610F\u540E\u518D\u6302\uFF1B\u4E4B\u540E\u53EF\u5230\u8DEF\u53E3\u5F15\u5BFC\u6D88\u9632\u8F66\u3002"
      practice: 
      illustration: {fileID: 0}
    - heading: "\u7535\u6C14\u706B\u707E\u5148\u65AD\u7535"
      body: "\u53D1\u73B0\u7535\u6C14\u8BBE\u5907\u8D77\u706B\uFF0C\u7B2C\u4E00\u6B65\u662F\u62C9\u95F8\u6216\u62D4\u63D2\u5934\u5207\u65AD\u7535\u6E90\uFF0C\u518D\u884C\u6251\u6551\u3002\u5E26\u7535\u6CFC\u6C34\u6709\u89E6\u7535\u5371\u9669\uFF0C\u5148\u65AD\u7535\u518D\u6251\u6551\u662F\u7535\u6C14\u706B\u707E\u5904\u7F6E\u7684\u57FA\u672C\u539F\u5219\u3002"
      practice: "\u529E\u516C\u697C\u5173\uFF1A\u2460\u6309\u706B\u8B66\u6309\u94AE
        \u2192 \u2461\u914D\u7535\u7BB1\u65AD\u7535\uFF0C\u4E24\u8005\u5C31\u5728\u540C\u4E00\u6839\u67F1\u5B50\u4E0A\uFF0C\u5C31\u8FD1\u5904\u7F6E"
      illustration: {fileID: 0}
  - title: "\u706D\u706B\u5668\u4F7F\u7528"
    intro: "\u706D\u706B\u5668\u53EA\u7528\u4E8E\u521D\u671F\u706B\u60C5\u2014\u2014\u91CF\u529B\u6251\u6551\uFF0C\u4E0D\u53EF\u604B\u6218\u3002"
    cards:
    - heading: "\u201C\u63D0\u62D4\u63E1\u538B\u201D\u56DB\u6B65\u6CD5"
      body: "\u63D0\u8D77\u706D\u706B\u5668 \u2192 \u62D4\u6389\u4FDD\u9669\u9500
        \u2192 \u63E1\u4F4F\u55B7\u7BA1\u5BF9\u51C6\u706B\u7130\u6839\u90E8 \u2192
        \u538B\u4E0B\u538B\u628A\u6301\u7EED\u55B7\u5C04\u3002\n\u5BF9\u51C6\u71C3\u70E7\u7269\u6839\u90E8\u624D\u80FD\u6709\u6548\u8986\u76D6\u3001\u5FEB\u901F\u706D\u706B\u3002"
      practice: "\u5BBF\u820D\u5173/\u529E\u516C\u697C\u5173\uFF1A\u4E3E\u8D77\u706D\u706B\u5668\u540E\u6309\u4F4F\u5DE6\u952E\uFF0C\u5BF9\u51C6\u706B\u7130\u6839\u90E8\u55B7\u5C04"
      illustration: {fileID: 21300000, guid: dc02c90845d49ed4a88af8c346859557, type: 3}
    - heading: "\u9002\u7528\u4E0E\u7981\u5FCC"
      body: "\u5E72\u7C89\u706D\u706B\u5668\u9002\u7528\u4E8E\u56FA\u4F53\u3001\u6DB2\u4F53\u3001\u6C14\u4F53\u706B\u707E\u53CA\u5E26\u7535\u521D\u671F\u706B\u3002\u6CB9\u9505\u8D77\u706B\u5E94\u76D6\u9505\u76D6\u7A92\u606F\u706D\u706B\uFF0C\u5207\u52FF\u6CFC\u6C34\uFF1B\u9152\u7CBE\u7B49\u6613\u71C3\u6DB2\u4F53\u8D77\u706B\u7528\u6E7F\u5E03\u8986\u76D6\u3002"
      practice: 
      illustration: {fileID: 0}
    - heading: "\u5242\u91CF\u6709\u9650\u91CF\u529B\u800C\u884C"
      body: "\u4E00\u5177\u6807\u51C6\u706D\u706B\u5668\u53EA\u80FD\u8FDE\u7EED\u55B7\u5C04\u5341\u51E0\u79D2\uFF0C\u53EA\u591F\u6251\u706D\u521D\u671F\u706B\u3002\u706B\u52BF\u5DF2\u5927\u65F6\u679C\u65AD\u653E\u5F03\u6251\u6551\u3001\u7ACB\u5373\u64A4\u79BB\u2014\u2014\u8FDC\u7AEF\u7684\u5927\u706B\u672C\u6765\u5C31\u706D\u4E0D\u4E86\uFF0C\u5207\u52FF\u604B\u6218\u3002"
      practice: "\u529E\u516C\u697C\u5173\uFF1A\u5DE5\u4F4D\u521D\u671F\u706B\u53EF\u6251\u706D\uFF0C\u8513\u5EF6\u540E\u7684\u5927\u706B\u65E0\u6CD5\u6251\u706D\uFF0C\u8FD9\u662F\u672C\u6E38\u620F\u7684\u6559\u5B66\u70B9"
      illustration: {fileID: 0}
  - title: "\u9003\u751F\u8981\u70B9"
    intro: "\u9003\u751F\u7684\u76EE\u6807\u662F\u6D3B\u7740\u79BB\u5F00\uFF0C\u800C\u4E0D\u662F\u6D88\u706D\u706B\u707E\u3002"
    cards:
    - heading: "\u4F4E\u59FF + \u6E7F\u6BDB\u5DFE"
      body: "\u7A7F\u8FC7\u6D53\u70DF\u533A\u65F6\u5F2F\u8170\u4F4E\u59FF\u751A\u81F3\u530D\u5310\uFF0C\u540C\u65F6\u7528\u6E7F\u6BDB\u5DFE\u6342\u4F4F\u53E3\u9F3B\uFF0C\u8FC7\u6EE4\u70DF\u5C18\u3001\u964D\u4F4E\u5438\u5165\u6BD2\u6C14\u4F24\u5BB3\u3002"
      practice: "\u5BBF\u820D\u5173\uFF1A\u5230\u4E1C\u5357\u89D2\u6309 E \u53D6\u6E7F\u6BDB\u5DFE\uFF0C\u6309
        Ctrl \u8E72\u4E0B\u4F4E\u59FF\u524D\u884C"
      illustration: {fileID: 21300000, guid: 476cca146b93aab43a9e48d993b7324d, type: 3}
    - heading: "\u8BA4\u51C6\u758F\u6563\u6807\u5FD7"
      body: "\u6CBF\u7EFF\u8272\u5B89\u5168\u51FA\u53E3\u6307\u793A\u6807\u5FD7\u64A4\u79BB\u3002\u4E0D\u8D2A\u604B\u8D22\u7269\u3001\u4E0D\u56DE\u5934\u3001\u4E0D\u6298\u8FD4\u2014\u2014\u706B\u52BF\u8513\u5EF6\u53EA\u9700\u51E0\u5341\u79D2\u3002"
      practice: "\u529E\u516C\u697C\u5173\uFF1A\u6CBF\u7EFF\u8272\u6307\u793A\u4ECE\u524D\u5385\u4E3B\u5165\u53E3\u64A4\u79BB"
      illustration: {fileID: 0}
    - heading: "\u8D70\u697C\u68AF\u4E0D\u4E58\u7535\u68AF"
      body: "\u706B\u707E\u5E38\u4F34\u968F\u65AD\u7535\uFF0C\u7535\u68AF\u968F\u65F6\u53EF\u80FD\u505C\u5728\u697C\u5C42\u4E4B\u95F4\u628A\u4EBA\u56F0\u4F4F\uFF0C\u52A1\u5FC5\u8D70\u758F\u6563\u697C\u68AF\u3002"
      practice: "\u529E\u516C\u697C\u5173\uFF1A\u7535\u68AF\u9677\u9631\u2014\u2014\u8FDB\u8F7F\u53A2\u4F1A\u88AB\u56F0\u4F4F\uFF0C\u4E3B\u5165\u53E3\u624D\u662F\u6B63\u786E\u8DEF\u7EBF"
      illustration: {fileID: 0}
    - heading: "\u706B\u5DF2\u5C01\u95E8\u600E\u4E48\u529E"
      body: "\u82E5\u95E8\u5916\u706B\u52BF\u592A\u5927\u65E0\u6CD5\u901A\u8FC7\uFF0C\u9000\u56DE\u623F\u95F4\u5173\u95E8\uFF0C\u7528\u6E7F\u5E03\u5835\u4F4F\u95E8\u7F1D\u3001\u4E0D\u65AD\u6CFC\u6C34\u964D\u6E29\uFF0C\u5230\u7A97\u53E3\u547C\u6551\u7B49\u5F85\u6551\u63F4\u3002\u76F2\u76EE\u51B2\u8FC7\u706B\u6D77\u4E5D\u6B7B\u4E00\u751F\u3002"
      practice: 
      illustration: {fileID: 0}
  - title: "\u5E38\u89C1\u8BEF\u533A"
    intro: "\u706B\u573A\u4E2D\u7684\u6BCF\u4E2A\u201C\u60F3\u5F53\u7136\u201D\u90FD\u53EF\u80FD\u81F4\u547D\u3002"
    cards:
    - heading: "\u201C\u6536\u62FE\u597D\u8D22\u7269\u518D\u9003\u201D"
      body: "\u706B\u52BF\u8513\u5EF6\u53EA\u8981\u51E0\u5341\u79D2\uFF0C\u4E3A\u6536\u62FE\u8D22\u7269\u5EF6\u8BEF\u9003\u751F\u662F\u6700\u5E38\u89C1\u4E5F\u6700\u81F4\u547D\u7684\u9519\u8BEF\u3002\u8D22\u7269\u53EF\u4EE5\u518D\u6323\uFF0C\u751F\u547D\u53EA\u6709\u4E00\u6B21\u3002"
      practice: 
      illustration: {fileID: 21300000, guid: 6240d3299283a8e4f9906dc362319f6a, type: 3}
    - heading: "\u201C\u4E58\u7535\u68AF\u4E0B\u697C\u6700\u5FEB\u201D"
      body: "\u706B\u707E\u5E38\u4F34\u968F\u65AD\u7535\uFF0C\u88AB\u56F0\u5728\u697C\u5C42\u4E4B\u95F4\u7684\u6B63\u662F\u4E58\u7535\u68AF\u7684\u4EBA\u3002\u758F\u6563\u697C\u68AF\u624D\u662F\u552F\u4E00\u53EF\u9760\u7684\u5782\u76F4\u9003\u751F\u901A\u9053\u3002"
      practice: "\u529E\u516C\u697C\u5173\uFF1A\u4EB2\u81EA\u4F53\u9A8C\u4E00\u6B21\u7535\u68AF\u9677\u9631\uFF0C\u8BB0\u4F4F\u201C\u7535\u68AF\uFF1D\u706B\u573A\u9677\u9631\u201D"
      illustration: {fileID: 0}
    - heading: "\u201C\u76F4\u7ACB\u5FEB\u8DD1\u51B2\u8FC7\u6D53\u70DF\u201D"
      body: "\u70DF\u6C14\u805A\u96C6\u5728\u4E0A\u5C42\uFF0C\u76F4\u7ACB\u5FEB\u8DD1\u4F1A\u5438\u5165\u6700\u591A\u6BD2\u70DF\u3002\u6B63\u786E\u505A\u6CD5\u662F\u5F2F\u8170\u4F4E\u59FF\u751A\u81F3\u530D\u5310\u8D34\u5730\u524D\u884C\u3002"
      practice: "\u529E\u516C\u697C\u5173\uFF1A\u7AD9\u7ACB\u7A7F\u70DF\u533A\u4F24\u5BB3\u6781\u9AD8\uFF0C\u8E72\u4E0B\u4F24\u5BB3\u9AA4\u51CF"
      illustration: {fileID: 0}
    - heading: "\u201C\u6CFC\u6C34\u4E07\u80FD\u201D"
      body: "\u7535\u6C14\u706B\u707E\u6CFC\u6C34\u6709\u89E6\u7535\u5371\u9669\uFF0C\u6CB9\u9505\u8D77\u706B\u6CFC\u6C34\u4F1A\u5BFC\u81F4\u6CB9\u82B1\u98DE\u6E85\u3001\u706B\u52BF\u7206\u71C3\u6269\u5927\u3002\u7535\u6C14\u5148\u65AD\u7535\u3001\u6CB9\u9505\u76D6\u9505\u76D6\u624D\u6B63\u786E\u3002"
      practice: 
      illustration: {fileID: 0}
    - heading: "\u201C\u539F\u8DEF\u8FD4\u56DE\u627E\u4EBA\u62FF\u7269\u201D"
      body: "\u706B\u573A\u4E2D\u4E0D\u8981\u6298\u8FD4\u5BFB\u627E\u4EBA\u6216\u8D22\u7269\uFF0C\u5E94\u5C31\u8FD1\u6CBF\u758F\u6563\u6807\u5FD7\u64A4\u79BB\u3002\u6298\u8FD4\u7684\u4EBA\u5F80\u5F80\u88AB\u8513\u5EF6\u7684\u706B\u52BF\u548C\u6D53\u70DF\u56F0\u4F4F\u3002"
      practice: 
      illustration: {fileID: 0}
  quizItems:
  - question: "\u529E\u516C\u697C\u53D1\u751F\u706B\u707E\uFF0C\u4F60\u5E94\u8BE5\u9996\u5148\u505A\u4EC0\u4E48\uFF1F"
    optionA: "\u6536\u62FE\u597D\u7535\u8111\u548C\u8D22\u7269\u518D\u9003"
    optionB: "\u5927\u58F0\u793A\u8B66\u5E76\u6309\u4E0B\u624B\u52A8\u706B\u707E\u62A5\u8B66\u6309\u94AE"
    optionC: "\u8EB2\u8FDB\u6CA1\u7740\u706B\u7684\u623F\u95F4\u7B49\u5F85\u6551\u63F4"
    correctIndex: 1
    explanation: "\u62A5\u8B66\u662F\u7B2C\u4E00\u4F4D\u7684\u2014\u2014\u8D8A\u65E9\u62A5\u8B66\uFF0C\u8D8A\u65E9\u83B7\u5F97\u6551\u63F4\uFF1B\u8D22\u7269\u53EF\u4EE5\u518D\u6323\uFF0C\u751F\u547D\u53EA\u6709\u4E00\u6B21\u3002"
    illustration: {fileID: 21300000, guid: 91ada6ec98d84b8449e8eae9fb280bf1, type: 3}
  - question: "\u706B\u573A\u4E2D\u901A\u8FC7\u6D53\u70DF\u5F25\u6F2B\u7684\u8D70\u5ECA\uFF0C\u6B63\u786E\u59FF\u52BF\u662F\uFF1F"
    optionA: "\u76F4\u7ACB\u5FEB\u8DD1\uFF0C\u5C3D\u5FEB\u51B2\u8FC7\u53BB"
    optionB: "\u4E58\u5750\u7535\u68AF\u5FEB\u901F\u4E0B\u697C"
    optionC: "\u5F2F\u8170\u4F4E\u59FF\u751A\u81F3\u530D\u5310\u8D34\u5730\u524D\u884C"
    correctIndex: 2
    explanation: "\u70DF\u6C14\u53D7\u70ED\u4E0A\u6D6E\uFF0C\u8D34\u8FD1\u5730\u9762\u7684\u7A7A\u6C14\u66F4\u6E05\u6D01\uFF0C\u4F4E\u59FF\u80FD\u5927\u5E45\u51CF\u5C11\u5438\u5165\u6BD2\u70DF\u3002"
    illustration: {fileID: 21300000, guid: 7e7d626a89ef6e548bc758f264d95481, type: 3}
  - question: "\u706B\u707E\u65F6\u80FD\u5426\u4E58\u5750\u7535\u68AF\u9003\u751F\uFF1F"
    optionA: "\u53EF\u4EE5\uFF0C\u7535\u68AF\u6700\u5FEB"
    optionB: "\u4E0D\u53EF\u4EE5\uFF0C\u968F\u65F6\u65AD\u7535\u4F1A\u88AB\u56F0"
    optionC: "\u4EBA\u591A\u6324\u4E00\u6324\u5C31\u884C"
    correctIndex: 1
    explanation: "\u706B\u707E\u5E38\u4F34\u968F\u65AD\u7535\uFF0C\u7535\u68AF\u968F\u65F6\u53EF\u80FD\u505C\u5728\u697C\u5C42\u4E4B\u95F4\u628A\u4EBA\u56F0\u4F4F\uFF0C\u52A1\u5FC5\u8D70\u758F\u6563\u697C\u68AF\u3002"
    illustration: {fileID: 21300000, guid: 406ca94db99cd8b44bc1eda6913ecb45, type: 3}
  - question: "\u7535\u6C14\u8BBE\u5907\u8D77\u706B\uFF0C\u7B2C\u4E00\u6B65\u5E94\u8BE5\uFF1F"
    optionA: "\u76F4\u63A5\u6CFC\u6C34\u706D\u706B"
    optionB: "\u5148\u5207\u65AD\u7535\u6E90\uFF0C\u518D\u7528\u706D\u706B\u5668\u6251\u6551"
    optionC: "\u7528\u4E66\u672C\u62CD\u6253\u706D\u706B"
    correctIndex: 1
    explanation: "\u5E26\u7535\u6CFC\u6C34\u6709\u89E6\u7535\u5371\u9669\uFF1B\u5148\u65AD\u7535\u518D\u6251\u6551\u662F\u7535\u6C14\u706B\u707E\u7684\u57FA\u672C\u539F\u5219\u3002"
    illustration: {fileID: 21300000, guid: 5a36c20ab02dd0e44997cc255aa8b4a4, type: 3}
  - question: "\u5E72\u7C89\u706D\u706B\u5668\u55B7\u5C04\u65F6\u8981\u5BF9\u51C6\u706B\u7130\u7684\u54EA\u91CC\uFF1F"
    optionA: "\u706B\u7130\u4E0A\u65B9\u7684\u70DF\u96FE"
    optionB: "\u706B\u7130\u6839\u90E8"
    optionC: "\u968F\u610F\u5DE6\u53F3\u626B\u5C04"
    correctIndex: 1
    explanation: "\u5BF9\u51C6\u71C3\u70E7\u7269\u6839\u90E8\u624D\u80FD\u6709\u6548\u8986\u76D6\u3001\u5FEB\u901F\u706D\u706B\u3002"
    illustration: {fileID: 21300000, guid: 2efd9a9c0b3f6004c8f6462c5f00d526, type: 3}
  - question: "\u6DF1\u591C\u88AB\u523A\u9F3B\u70DF\u5473\u545B\u9192\uFF0C\u6B63\u786E\u505A\u6CD5\u662F\uFF1F"
    optionA: "\u7ACB\u523B\u5F00\u95E8\u51B2\u51FA\u53BB"
    optionB: "\u5148\u6478\u95E8\u628A\u624B\u5224\u65AD\u706B\u60C5\uFF0C\u518D\u51B3\u5B9A\u9003\u751F\u6216\u56FA\u5B88\u5F85\u63F4"
    optionC: "\u5F00\u7A97\u8DF3\u697C\u9003\u751F"
    correctIndex: 1
    explanation: "\u95E8\u628A\u624B\u53D1\u70EB\u8BF4\u660E\u95E8\u5916\u5DF2\u662F\u706B\u6D77\uFF0C\u5E94\u5173\u95E8\u5835\u7F1D\u56FA\u5B88\u5F85\u63F4\uFF1B\u4E0D\u70EB\u5219\u4F4E\u59FF\u5FEB\u901F\u64A4\u79BB\u3002"
    illustration: {fileID: 21300000, guid: 2d79883d60fb38a45a0133d32634c18b, type: 3}
  - question: "\u9003\u751F\u65F6\u6E7F\u6BDB\u5DFE\u7684\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    optionA: "\u906E\u6321\u706B\u5149\u4FDD\u62A4\u773C\u775B"
    optionB: "\u8FC7\u6EE4\u5438\u9644\u70DF\u5C18\u6BD2\u6C14\uFF0C\u51CF\u5C11\u5438\u5165\u4F24\u5BB3"
    optionC: "\u6CA1\u6709\u5B9E\u9645\u4F5C\u7528"
    correctIndex: 1
    explanation: "\u6E7F\u6BDB\u5DFE\u6342\u4F4F\u53E3\u9F3B\u53EF\u8FC7\u6EE4\u5438\u9644\u90E8\u5206\u70DF\u5C18\u4E0E\u6BD2\u6C14\uFF0C\u4E3A\u9003\u751F\u4E89\u53D6\u65F6\u95F4\u3002"
    illustration: {fileID: 21300000, guid: 64b065101d68b5c4db278497bf69ab5e, type: 3}
  - question: "\u7092\u83DC\u65F6\u6CB9\u9505\u8D77\u706B\uFF0C\u6B63\u786E\u505A\u6CD5\u662F\uFF1F"
    optionA: "\u6CFC\u6C34\u706D\u706B"
    optionB: "\u5173\u706B\u540E\u76D6\u4E0A\u9505\u76D6\u7A92\u606F\u706D\u706B"
    optionC: "\u5012\u8FDB\u66F4\u591A\u6CB9\u7A00\u91CA"
    correctIndex: 1
    explanation: "\u6CB9\u9505\u706B\u6CFC\u6C34\u4F1A\u5F15\u53D1\u6CB9\u82B1\u98DE\u6E85\u7206\u71C3\uFF0C\u5173\u706B\u76D6\u9505\u76D6\u624D\u80FD\u7A92\u606F\u706D\u706B\u3002"
    illustration: {fileID: 21300000, guid: 5b472c60828884b409d2d1ef10be8a08, type: 3}
  - question: "\u5B89\u5168\u51FA\u53E3\u758F\u6563\u6307\u793A\u6807\u5FD7\u662F\u4EC0\u4E48\u989C\u8272\uFF1F"
    optionA: "\u7EFF\u8272"
    optionB: "\u7EA2\u8272"
    optionC: "\u9EC4\u8272"
    correctIndex: 0
    explanation: "\u7EFF\u8272\u662F\u5B89\u5168\u758F\u6563\u7684\u989C\u8272\uFF1B\u706B\u573A\u4E2D\u6CBF\u7EFF\u8272\u6307\u793A\u6807\u5FD7\u64A4\u79BB\u3002"
    illustration: {fileID: 21300000, guid: 1a53439bf05f1ab4484b0599f9c6b2b8, type: 3}
  - question: "\u697C\u9053\u706B\u5DF2\u5C01\u95E8\u3001\u65E0\u6CD5\u9003\u79BB\u65F6\uFF0C\u5E94\u8BE5\uFF1F"
    optionA: "\u5F3A\u884C\u51B2\u8FC7\u706B\u6D77"
    optionB: "\u9000\u56DE\u623F\u95F4\u5173\u95E8\uFF0C\u6E7F\u5E03\u5835\u7F1D\u6CFC\u6C34\u964D\u6E29\uFF0C\u7A97\u53E3\u547C\u6551\u7B49\u5F85\u6551\u63F4"
    optionC: "\u539F\u5730\u5927\u58F0\u54ED\u558A"
    correctIndex: 1
    explanation: "\u56FA\u5B88\u5F85\u63F4\u662F\u6700\u540E\u7684\u6B63\u786E\u9009\u62E9\uFF1A\u5835\u4F4F\u95E8\u7F1D\u5EF6\u7F13\u70DF\u6C14\uFF0C\u5728\u7A97\u53E3\u547C\u6551\u5F15\u5BFC\u6551\u63F4\u3002"
    illustration: {fileID: 21300000, guid: 0250c89a9524d404d948844da768c813, type: 3}
