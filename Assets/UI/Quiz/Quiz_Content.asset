  questions:
  - question: "\u529E\u516C\u697C\u53D1\u751F\u706B\u707E\uFF0C\u4F60\u5E94\u8BE5\u9996\u5148\u505A\u4EC0\u4E48\uFF1F"
    optionA: "\u6536\u62FE\u597D\u7535\u8111\u548C\u8D22\u7269\u518D\u9003"
    optionB: "\u5927\u58F0\u793A\u8B66\u5E76\u6309\u4E0B\u624B\u52A8\u706B\u707E\u62A5\u8B66\u6309\u94AE"
    optionC: "\u8EB2\u8FDB\u6CA1\u7740\u706B\u7684\u623F\u95F4\u7B49\u5F85\u6551\u63F4"
    correctIndex: 1
    explanation: "\u62A5\u8B66\u662F\u7B2C\u4E00\u4F4D\u7684\u2014\u2014\u8D8A\u65E9\u62A5\u8B66\uFF0C\u8D8A\u65E9\u83B7\u5F97\u6551\u63F4\uFF1B\u8D22\u7269\u53EF\u4EE5\u518D\u6323\uFF0C\u751F\u547D\u53EA\u6709\u4E00\u6B21\u3002"
    illustration: {fileID: 21300000, guid: 91ada6ec98d84b8449e8eae9fb280bf1, type: 3}
    scienceCategoryIndex: 1
  - question: "\u706B\u573A\u4E2D\u901A\u8FC7\u6D53\u70DF\u5F25\u6F2B\u7684\u8D70\u5ECA\uFF0C\u6B63\u786E\u59FF\u52BF\u662F\uFF1F"
    optionA: "\u76F4\u7ACB\u5FEB\u8DD1\uFF0C\u5C3D\u5FEB\u51B2\u8FC7\u53BB"
    optionB: "\u4E58\u5750\u7535\u68AF\u5FEB\u901F\u4E0B\u697C"
    optionC: "\u5F2F\u8170\u4F4E\u59FF\u751A\u81F3\u530D\u5310\u8D34\u5730\u524D\u884C"
    correctIndex: 2
    explanation: "\u70DF\u6C14\u53D7\u70ED\u4E0A\u6D6E\uFF0C\u8D34\u8FD1\u5730\u9762\u7684\u7A7A\u6C14\u66F4\u6E05\u6D01\uFF0C\u4F4E\u59FF\u80FD\u5927\u5E45\u51CF\u5C11\u5438\u5165\u6BD2\u70DF\u3002"
    illustration: {fileID: 21300000, guid: 7e7d626a89ef6e548bc758f264d95481, type: 3}
    scienceCategoryIndex: 3
  - question: "\u706B\u707E\u65F6\u80FD\u5426\u4E58\u5750\u7535\u68AF\u9003\u751F\uFF1F"
    optionA: "\u53EF\u4EE5\uFF0C\u7535\u68AF\u6700\u5FEB"
    optionB: "\u4E0D\u53EF\u4EE5\uFF0C\u968F\u65F6\u65AD\u7535\u4F1A\u88AB\u56F0"
    optionC: "\u4EBA\u591A\u6324\u4E00\u6324\u5C31\u884C"
    correctIndex: 1
    explanation: "\u706B\u707E\u5E38\u4F34\u968F\u65AD\u7535\uFF0C\u7535\u68AF\u968F\u65F6\u53EF\u80FD\u505C\u5728\u697C\u5C42\u4E4B\u95F4\u628A\u4EBA\u56F0\u4F4F\uFF0C\u52A1\u5FC5\u8D70\u758F\u6563\u697C\u68AF\u3002"
    illustration: {fileID: 21300000, guid: 406ca94db99cd8b44bc1eda6913ecb45, type: 3}
    scienceCategoryIndex: 4
  - question: "\u7535\u6C14\u8BBE\u5907\u8D77\u706B\uFF0C\u7B2C\u4E00\u6B65\u5E94\u8BE5\uFF1F"
    optionA: "\u76F4\u63A5\u6CFC\u6C34\u706D\u706B"
    optionB: "\u5148\u5207\u65AD\u7535\u6E90\uFF0C\u518D\u7528\u706D\u706B\u5668\u6251\u6551"
    optionC: "\u7528\u4E66\u672C\u62CD\u6253\u706D\u706B"
    correctIndex: 1
    explanation: "\u5E26\u7535\u6CFC\u6C34\u6709\u89E6\u7535\u5371\u9669\uFF1B\u5148\u65AD\u7535\u518D\u6251\u6551\u662F\u7535\u6C14\u706B\u707E\u7684\u57FA\u672C\u539F\u5219\u3002"
    illustration: {fileID: 21300000, guid: 5a36c20ab02dd0e44997cc255aa8b4a4, type: 3}
    scienceCategoryIndex: 1
  - question: "\u5E72\u7C89\u706D\u706B\u5668\u55B7\u5C04\u65F6\u8981\u5BF9\u51C6\u706B\u7130\u7684\u54EA\u91CC\uFF1F"
    optionA: "\u706B\u7130\u4E0A\u65B9\u7684\u70DF\u96FE"
    optionB: "\u706B\u7130\u6839\u90E8"
    optionC: "\u968F\u610F\u5DE6\u53F3\u626B\u5C04"
    correctIndex: 1
    explanation: "\u5BF9\u51C6\u71C3\u70E7\u7269\u6839\u90E8\u624D\u80FD\u6709\u6548\u8986\u76D6\u3001\u5FEB\u901F\u706D\u706B\u3002"
    illustration: {fileID: 21300000, guid: 2efd9a9c0b3f6004c8f6462c5f00d526, type: 3}
    scienceCategoryIndex: 2
  - question: "\u6DF1\u591C\u88AB\u523A\u9F3B\u70DF\u5473\u545B\u9192\uFF0C\u6B63\u786E\u505A\u6CD5\u662F\uFF1F"
    optionA: "\u7ACB\u523B\u5F00\u95E8\u51B2\u51FA\u53BB"
    optionB: "\u5148\u6478\u95E8\u628A\u624B\u5224\u65AD\u706B\u60C5\uFF0C\u518D\u51B3\u5B9A\u9003\u751F\u6216\u56FA\u5B88\u5F85\u63F4"
    optionC: "\u5F00\u7A97\u8DF3\u697C\u9003\u751F"
    correctIndex: 1
    explanation: "\u95E8\u628A\u624B\u53D1\u70EB\u8BF4\u660E\u95E8\u5916\u5DF2\u662F\u706B\u6D77\uFF0C\u5E94\u5173\u95E8\u5835\u7F1D\u56FA\u5B88\u5F85\u63F4\uFF1B\u4E0D\u70EB\u5219\u4F4E\u59FF\u5FEB\u901F\u64A4\u79BB\u3002"
    illustration: {fileID: 21300000, guid: 2d79883d60fb38a45a0133d32634c18b, type: 3}
    scienceCategoryIndex: 3
  - question: "\u9003\u751F\u65F6\u6E7F\u6BDB\u5DFE\u7684\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    optionA: "\u906E\u6321\u706B\u5149\u4FDD\u62A4\u773C\u775B"
    optionB: "\u8FC7\u6EE4\u5438\u9644\u70DF\u5C18\u6BD2\u6C14\uFF0C\u51CF\u5C11\u5438\u5165\u4F24\u5BB3"
    optionC: "\u6CA1\u6709\u5B9E\u9645\u4F5C\u7528"
    correctIndex: 1
    explanation: "\u6E7F\u6BDB\u5DFE\u6342\u4F4F\u53E3\u9F3B\u53EF\u8FC7\u6EE4\u5438\u9644\u90E8\u5206\u70DF\u5C18\u4E0E\u6BD2\u6C14\uFF0C\u4E3A\u9003\u751F\u4E89\u53D6\u65F6\u95F4\u3002"
    illustration: {fileID: 21300000, guid: 64b065101d68b5c4db278497bf69ab5e, type: 3}
    scienceCategoryIndex: 3
  - question: "\u7092\u83DC\u65F6\u6CB9\u9505\u8D77\u706B\uFF0C\u6B63\u786E\u505A\u6CD5\u662F\uFF1F"
    optionA: "\u6CFC\u6C34\u706D\u706B"
    optionB: "\u5173\u706B\u540E\u76D6\u4E0A\u9505\u76D6\u7A92\u606F\u706D\u706B"
    optionC: "\u5012\u8FDB\u66F4\u591A\u6CB9\u7A00\u91CA"
    correctIndex: 1
    explanation: "\u6CB9\u9505\u706B\u6CFC\u6C34\u4F1A\u5F15\u53D1\u6CB9\u82B1\u98DE\u6E85\u7206\u71C3\uFF0C\u5173\u706B\u76D6\u9505\u76D6\u624D\u80FD\u7A92\u606F\u706D\u706B\u3002"
    illustration: {fileID: 21300000, guid: 5b472c60828884b409d2d1ef10be8a08, type: 3}
    scienceCategoryIndex: 2
  - question: "\u5B89\u5168\u51FA\u53E3\u758F\u6563\u6307\u793A\u6807\u5FD7\u662F\u4EC0\u4E48\u989C\u8272\uFF1F"
    optionA: "\u7EFF\u8272"
    optionB: "\u7EA2\u8272"
    optionC: "\u9EC4\u8272"
    correctIndex: 0
    explanation: "\u7EFF\u8272\u662F\u5B89\u5168\u758F\u6563\u7684\u989C\u8272\uFF1B\u706B\u573A\u4E2D\u6CBF\u7EFF\u8272\u6307\u793A\u6807\u5FD7\u64A4\u79BB\u3002"
    illustration: {fileID: 21300000, guid: 1a53439bf05f1ab4484b0599f9c6b2b8, type: 3}
    scienceCategoryIndex: 3
  - question: "\u697C\u9053\u706B\u5DF2\u5C01\u95E8\u3001\u65E0\u6CD5\u9003\u79BB\u65F6\uFF0C\u5E94\u8BE5\uFF1F"
    optionA: "\u5F3A\u884C\u51B2\u8FC7\u706B\u6D77"
    optionB: "\u9000\u56DE\u623F\u95F4\u5173\u95E8\uFF0C\u6E7F\u5E03\u5835\u7F1D\u6CFC\u6C34\u964D\u6E29\uFF0C\u7A97\u53E3\u547C\u6551\u7B49\u5F85\u6551\u63F4"
    optionC: "\u539F\u5730\u5927\u58F0\u54ED\u558A"
    correctIndex: 1
    explanation: "\u56FA\u5B88\u5F85\u63F4\u662F\u6700\u540E\u7684\u6B63\u786E\u9009\u62E9\uFF1A\u5835\u4F4F\u95E8\u7F1D\u5EF6\u7F13\u70DF\u6C14\uFF0C\u5728\u7A97\u53E3\u547C\u6551\u5F15\u5BFC\u6551\u63F4\u3002"
    illustration: {fileID: 21300000, guid: 0250c89a9524d404d948844da768c813, type: 3}
    scienceCategoryIndex: 3
  - question: "\u706B\u707E\u53D1\u5C55\u7684\u201C\u521D\u671F\u9636\u6BB5\u201D\u662F\u6307\uFF1F"
    optionA: "\u8D77\u706B\u540E\u7684\u5934\u51E0\u5206\u949F\uFF0C\u706B\u52BF\u5C0F\u3001\u70DF\u5C11\uFF0C\u662F\u6251\u6551\u4E0E\u9003\u751F\u7684\u9EC4\u91D1\u7A97\u53E3"
    optionB: "\u706B\u52BF\u70E7\u5230\u6700\u5927\u7684\u65F6\u5019"
    optionC: "\u706B\u7130\u5373\u5C06\u81EA\u7136\u7184\u706D\u7684\u65F6\u5019"
    correctIndex: 0
    explanation: "\u521D\u671F\u706B\u706B\u52BF\u5C0F\u3001\u70DF\u5C11\uFF0C\u4E00\u5177\u706D\u706B\u5668\u5373\u53EF\u6251\u706D\uFF1B\u9519\u8FC7\u8FD9\u51E0\u5206\u949F\u7684\u9EC4\u91D1\u7A97\u53E3\uFF0C\u706B\u52BF\u5C06\u8FC5\u901F\u8513\u5EF6\u76F4\u81F3\u65E0\u6CD5\u63A7\u5236\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 0
  - question: "\u706B\u573A\u9047\u96BE\u8005\u4E2D\uFF0C\u5927\u591A\u6570\u4EBA\u7684\u76F4\u63A5\u6B7B\u56E0\u662F\uFF1F"
    optionA: "\u76F4\u63A5\u88AB\u70E7\u4F24"
    optionB: "\u70DF\u6C14\u4E2D\u6BD2\u4E0E\u7A92\u606F"
    optionC: "\u9003\u751F\u65F6\u62E5\u6324\u8E29\u8E0F"
    correctIndex: 1
    explanation: "\u591A\u6570\u9047\u96BE\u8005\u6B7B\u4E8E\u70DF\u6C14\u4E2D\u6BD2\u7A92\u606F\u800C\u975E\u70E7\u4F24\u2014\u2014\u6D53\u70DF\u51E0\u53E3\u5C31\u80FD\u8BA9\u4EBA\u5931\u53BB\u884C\u52A8\u80FD\u529B\uFF0C\u6342\u53E3\u9F3B\u3001\u4F4E\u59FF\u662F\u4FDD\u547D\u5173\u952E\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 0
  - question: "\u8EAB\u4E0A\u8863\u7269\u4E0D\u614E\u7740\u706B\uFF0C\u6B63\u786E\u505A\u6CD5\u662F\uFF1F"
    optionA: "\u5FEB\u901F\u5954\u8DD1\u627E\u6C34\u6E90\u706D\u706B"
    optionB: "\u7ACB\u5373\u505C\u4E0B\u3001\u5C31\u5730\u6253\u6EDA\u538B\u706D\u706B\u82D7"
    optionC: "\u7528\u624B\u76F4\u63A5\u62CD\u6253\u706B\u7130"
    correctIndex: 1
    explanation: "\u5954\u8DD1\u4F1A\u8BA9\u706B\u501F\u98CE\u52BF\u8D8A\u70E7\u8D8A\u65FA\uFF1B\u6B63\u786E\u53E3\u8BC0\u662F\u201C\u505C\u3001\u8EBA\u3001\u6EDA\u201D\uFF0C\u538B\u706D\u706B\u82D7\u540E\u518D\u5904\u7406\u70E7\u4F24\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 0
  - question: "\u201C\u8F70\u71C3\u201D\u6307\u7684\u662F\uFF1F"
    optionA: "\u5BA4\u5185\u53EF\u71C3\u7269\u51E0\u4E4E\u540C\u65F6\u88AB\u5F15\u71C3\u3001\u706B\u52BF\u77AC\u95F4\u5E2D\u5377\u5168\u5C4B\u7684\u73B0\u8C61"
    optionB: "\u706D\u706B\u5668\u55B7\u5C04\u65F6\u7684\u7206\u54CD"
    optionC: "\u71C3\u6C14\u7076\u6253\u706B\u7684\u706B\u82B1"
    correctIndex: 0
    explanation: "\u8F70\u71C3\u53D1\u751F\u540E\u5BA4\u5185\u77AC\u95F4\u6210\u4E3A\u706B\u6D77\uFF0C\u4EFB\u4F55\u6251\u6551\u90FD\u5931\u53BB\u610F\u4E49\u2014\u2014\u8FD9\u6B63\u662F\u5FC5\u987B\u6293\u4F4F\u521D\u671F\u706B\u3001\u679C\u65AD\u64A4\u79BB\u7684\u539F\u56E0\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 0
  - question: "\u62E8\u6253119\u62A5\u8B66\u65F6\uFF0C\u4E0B\u9762\u54EA\u9879\u5185\u5BB9\u53EF\u4EE5\u4E0D\u8BF4\uFF1F"
    optionA: "\u8D77\u706B\u8BE6\u7EC6\u5730\u5740"
    optionB: "\u6709\u65E0\u4EBA\u5458\u88AB\u56F0"
    optionC: "\u706B\u707E\u635F\u5931\u7684\u91D1\u989D\u7EDF\u8BA1"
    correctIndex: 2
    explanation: "119\u56DB\u8981\u7D20\uFF1A\u8BE6\u7EC6\u5730\u5740\u3001\u8D77\u706B\u7269\u8D28\u3001\u706B\u52BF\u5927\u5C0F\u3001\u6709\u65E0\u88AB\u56F0\u4EBA\u5458\uFF1B\u635F\u5931\u91D1\u989D\u662F\u4E8B\u540E\u7684\u4E8B\uFF0C\u62A5\u8B66\u65F6\u4E0D\u5FC5\u8BF4\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 1
  - question: "119\u63A5\u8B66\u5458\u8FD8\u6CA1\u8BF4\u201C\u53EF\u4EE5\u6302\u65AD\u201D\uFF0C\u4F60\u5E94\u8BE5\uFF1F"
    optionA: "\u76F4\u63A5\u6302\u65AD\u7535\u8BDD\u8FC5\u901F\u64A4\u79BB"
    optionB: "\u7B49\u63A5\u8B66\u5458\u8BB0\u5F55\u5B8C\u4FE1\u606F\u793A\u610F\u540E\u518D\u6302\u65AD\uFF0C\u5E76\u5230\u8DEF\u53E3\u5F15\u5BFC\u6D88\u9632\u8F66"
    optionC: "\u53CD\u590D\u62E8\u6253119\u50AC\u4FC3"
    correctIndex: 1
    explanation: "\u5148\u522B\u6302\u65AD\u2014\u2014\u63A5\u8B66\u5458\u53EF\u80FD\u8FD8\u8981\u786E\u8BA4\u5173\u952E\u4FE1\u606F\uFF1B\u6302\u65AD\u540E\u5230\u8DEF\u53E3\u5F15\u5BFC\u6D88\u9632\u8F66\uFF0C\u80FD\u660E\u663E\u7F29\u77ED\u6551\u63F4\u5230\u573A\u65F6\u95F4\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 1
  - question: "\u5BBF\u820D\u697C\u91CC\u7684\u70DF\u96FE\u62A5\u8B66\u5668\uFF08\u611F\u70DF\u63A2\u6D4B\u5668\uFF09\u4E3B\u8981\u4F5C\u7528\u662F\uFF1F"
    optionA: "\u81EA\u52A8\u55B7\u6C34\u706D\u706B"
    optionB: "\u5C3D\u65E9\u63A2\u6D4B\u70DF\u96FE\u53D1\u51FA\u8B66\u62A5\uFF0C\u4E3A\u9003\u751F\u4E89\u53D6\u65F6\u95F4"
    optionC: "\u81EA\u52A8\u9501\u95ED\u623F\u95E8"
    correctIndex: 1
    explanation: "\u62A5\u8B66\u5668\u7684\u4EF7\u503C\u5728\u4E8E\u201C\u65E9\u53D1\u73B0\u3001\u65E9\u9003\u751F\u201D\u2014\u2014\u706B\u707E\u521D\u671F\u591A\u4E89\u53D6\u51E0\u5341\u79D2\u8B66\u62A5\uFF0C\u5C31\u662F\u51E0\u5341\u79D2\u751F\u8DEF\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 1
  - question: "\u53D1\u73B0\u5BBF\u820D\u8D77\u706B\u51C6\u5907\u64A4\u79BB\u65F6\uFF0C\u8FD8\u5E94\u8BE5\uFF1F"
    optionA: "\u5927\u58F0\u547C\u558A\u63D0\u9192\u5BA4\u53CB\uFF0C\u8BA9\u5468\u56F4\u7684\u4EBA\u4E00\u8D77\u64A4\u79BB"
    optionB: "\u6084\u6084\u79BB\u5F00\u907F\u514D\u60CA\u52A8\u522B\u4EBA"
    optionC: "\u5148\u6536\u62FE\u5B8C\u8D35\u91CD\u7269\u54C1\u518D\u558A\u4EBA"
    correctIndex: 0
    explanation: "\u9003\u751F\u540C\u65F6\u5927\u58F0\u547C\u558A\u5524\u9192\u540C\u4F34\u662F\u6BCF\u4E2A\u4EBA\u7684\u8D23\u4EFB\uFF1B\u7761\u68A6\u4E2D\u7684\u4EBA\u53EF\u80FD\u6BEB\u65E0\u5BDF\u89C9\uFF0C\u4F60\u7684\u547C\u558A\u5C31\u662F\u4ED6\u4EEC\u7684\u8B66\u62A5\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 1
  - question: "\u5E72\u7C89\u706D\u706B\u5668\u4F7F\u7528\u7684\u56DB\u6B65\u53E3\u8BC0\u662F\uFF1F"
    optionA: "\u201C\u63D0\u3001\u62D4\u3001\u63E1\u3001\u538B\u201D"
    optionB: "\u201C\u6254\u3001\u8E22\u3001\u7838\u3001\u6CFC\u201D"
    optionC: "\u201C\u8DD1\u3001\u558A\u3001\u8EB2\u3001\u85CF\u201D"
    correctIndex: 0
    explanation: "\u63D0\u8D77\u706D\u706B\u5668\u2192\u62D4\u6389\u4FDD\u9669\u9500\u2192\u63E1\u4F4F\u55B7\u7BA1\u5BF9\u51C6\u706B\u7130\u6839\u90E8\u2192\u538B\u4E0B\u538B\u628A\u6301\u7EED\u55B7\u5C04\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 2
  - question: "\u4F7F\u7528\u706D\u706B\u5668\u706D\u706B\u65F6\uFF0C\u5E94\u7AD9\u5728\u706B\u7130\u7684\uFF1F"
    optionA: "\u4E0B\u98CE\u5411\uFF0C\u770B\u5F97\u66F4\u6E05\u695A"
    optionB: "\u4E0A\u98CE\u5411\u6216\u4FA7\u9762\uFF0C\u8DDD\u79BB\u706B\u71302-3\u7C73"
    optionC: "\u8D8A\u8D34\u8FD1\u706B\u7130\u6548\u679C\u8D8A\u597D"
    correctIndex: 1
    explanation: "\u4E0A\u98CE\u5411\u907F\u514D\u70DF\u706B\u6251\u5411\u81EA\u5DF1\uFF0C2-3\u7C73\u65E2\u5728\u6709\u6548\u5C04\u7A0B\u5185\u53C8\u4E0D\u4F1A\u88AB\u707C\u4F24\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 2
  - question: "\u9152\u7CBE\u7B49\u6613\u71C3\u6DB2\u4F53\u7740\u706B\uFF0C\u9519\u8BEF\u7684\u505A\u6CD5\u662F\uFF1F"
    optionA: "\u7528\u6E7F\u5E03\u6216\u6C99\u571F\u8986\u76D6"
    optionB: "\u7528\u5E72\u7C89\u706D\u706B\u5668\u6251\u6551"
    optionC: "\u6CFC\u6C34\u7A00\u91CA"
    correctIndex: 2
    explanation: "\u9152\u7CBE\u6BD4\u6C34\u8F7B\u4E14\u80FD\u968F\u6C34\u6D41\u6269\u6563\uFF0C\u6CFC\u6C34\u53CD\u800C\u4F1A\u8BA9\u706B\u52BF\u8513\u5EF6\uFF1B\u6E7F\u5E03\u8986\u76D6\u6216\u5E72\u7C89\u6251\u6551\u624D\u6B63\u786E\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 2
  - question: "\u5173\u4E8E\u4E00\u5177\u6807\u51C6\u706D\u706B\u5668\u7684\u6301\u7EED\u55B7\u5C04\u65F6\u957F\uFF0C\u6B63\u786E\u8BA4\u8BC6\u662F\uFF1F"
    optionA: "\u53EA\u80FD\u8FDE\u7EED\u55B7\u5C04\u5341\u51E0\u79D2\uFF0C\u4EC5\u591F\u6251\u706D\u521D\u671F\u5C0F\u706B"
    optionB: "\u80FD\u55B7\u597D\u51E0\u5206\u949F\uFF0C\u591A\u5927\u7684\u706B\u90FD\u80FD\u706D"
    optionC: "\u55B7\u5C04\u4E2D\u53EF\u4EE5\u968F\u65F6\u6682\u505C\u4FDD\u5B58\u5242\u91CF"
    correctIndex: 0
    explanation: "\u706D\u706B\u5668\u5242\u91CF\u6709\u9650\u3001\u53EA\u80FD\u5E94\u5BF9\u521D\u671F\u706B\u60C5\uFF1B\u706B\u52BF\u5DF2\u5927\u65F6\u679C\u65AD\u653E\u5F03\u6251\u6551\u3001\u7ACB\u5373\u64A4\u79BB\uFF0C\u5207\u83AB\u604B\u6218\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 2
  - question: "\u5165\u4F4F\u5BBE\u9986\u6216\u8FDB\u5165\u5546\u573A\u7B49\u964C\u751F\u573A\u6240\uFF0C\u5E94\u8BE5\u4F18\u5148\uFF1F"
    optionA: "\u67E5\u770B\u5B89\u5168\u51FA\u53E3\u4F4D\u7F6E\uFF0C\u8BB0\u4F4F\u4E24\u6761\u758F\u6563\u8DEF\u7EBF"
    optionB: "\u7ACB\u5373\u5F00\u59CB\u529E\u516C\u6216\u8D2D\u7269"
    optionC: "\u68C0\u67E5\u624B\u673A\u4FE1\u53F7"
    correctIndex: 0
    explanation: "\u706B\u707E\u4E2D\u614C\u4E71\u96BE\u8FA8\u65B9\u5411\uFF1B\u63D0\u524D\u8BB0\u4F4F\u4E24\u6761\u758F\u6563\u8DEF\u7EBF\uFF0C\u662F\u6700\u57FA\u7840\u7684\u201C\u9003\u751F\u9884\u6848\u201D\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 3
  - question: "\u901A\u8FC7\u5E38\u95ED\u5F0F\u9632\u706B\u95E8\uFF08\u5B89\u5168\u51FA\u53E3\u7684\u95E8\uFF09\u540E\u5E94\u8BE5\uFF1F"
    optionA: "\u968F\u624B\u628A\u95E8\u5173\u4E0A\u518D\u64A4\u79BB"
    optionB: "\u7528\u4E1C\u897F\u62B5\u4F4F\u95E8\u8BA9\u5B83\u655E\u5F00"
    optionC: "\u65E0\u6240\u8C13\uFF0C\u95E8\u4F1A\u81EA\u5DF1\u5173"
    correctIndex: 0
    explanation: "\u5173\u95ED\u7684\u9632\u706B\u95E8\u80FD\u963B\u6321\u70DF\u706B\u8513\u5EF6\u534A\u5C0F\u65F6\u4EE5\u4E0A\uFF0C\u901A\u8FC7\u540E\u968F\u624B\u5173\u95E8\u662F\u5728\u4FDD\u62A4\u8EAB\u540E\u7684\u4EBA\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 3
  - question: "\u6D53\u70DF\u5F25\u6F2B\u65F6\uFF0C\u6E7F\u6BDB\u5DFE\u7684\u6B63\u786E\u7528\u6CD5\u662F\uFF1F"
    optionA: "\u6298\u53E0\u6570\u5C42\u6342\u4F4F\u53E3\u9F3B\uFF0C\u914D\u5408\u4F4E\u59FF\u524D\u884C"
    optionB: "\u4E3E\u5728\u5934\u9876\u906E\u6321\u70DF\u5C18"
    optionC: "\u57AB\u5728\u8EAB\u4E0B\u9632\u70EB"
    correctIndex: 0
    explanation: "\u6298\u53E0\u6570\u5C42\u7684\u6E7F\u6BDB\u5DFE\u8FC7\u6EE4\u6548\u679C\u6700\u597D\uFF1B\u201C\u6342\u53E3\u9F3B+\u4F4E\u59FF\u201D\u662F\u7A7F\u8D8A\u6D53\u70DF\u533A\u7684\u6807\u51C6\u7EC4\u5408\u52A8\u4F5C\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 3
  - question: "\u706B\u707E\u8B66\u62A5\u7A81\u7136\u54CD\u8D77\u65F6\uFF0C\u6B63\u786E\u7684\u7B2C\u4E00\u53CD\u5E94\u662F\uFF1F"
    optionA: "\u7ACB\u5373\u4F4E\u59FF\u6CBF\u758F\u6563\u6307\u793A\u64A4\u79BB"
    optionB: "\u5148\u6D17\u6F31\u6362\u597D\u8863\u670D\u518D\u8D70"
    optionC: "\u7EE7\u7EED\u4F11\u606F\uFF0C\u7B49\u5BA4\u53CB\u786E\u8BA4\u771F\u7684\u7740\u706B"
    correctIndex: 0
    explanation: "\u8B66\u62A5\u5C31\u662F\u64A4\u79BB\u4FE1\u53F7\uFF1B\u706B\u52BF\u8513\u5EF6\u53EA\u9700\u51E0\u5341\u79D2\uFF0C\u4EFB\u4F55\u5EF6\u8BEF\u90FD\u53EF\u80FD\u88AB\u5C01\u4F4F\u9000\u8DEF\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 3
  - question: "\u64A4\u79BB\u5230\u5B89\u5168\u5730\u5E26\u540E\u53D1\u73B0\u94B1\u5305\u8FD8\u5728\u623F\u95F4\uFF0C\u5E94\u8BE5\uFF1F"
    optionA: "\u7EDD\u4E0D\u8FD4\u56DE\uFF0C\u8D22\u7269\u53EF\u4EE5\u518D\u6323"
    optionB: "\u5FEB\u901F\u8DD1\u56DE\u53BB\u62FF"
    optionC: "\u8BA9\u6D88\u9632\u5458\u5E2E\u5FD9\u5E26\u51FA\u6765"
    correctIndex: 0
    explanation: "\u8FD4\u56DE\u53D6\u7269\u662F\u706B\u573A\u6700\u81F4\u547D\u7684\u9519\u8BEF\uFF1A\u706B\u52BF\u4E0E\u6D53\u70DF\u8513\u5EF6\u8FDC\u8D85\u60F3\u8C61\uFF0C\u8FDB\u53BB\u7684\u4EBA\u5F80\u5F80\u518D\u4E5F\u51FA\u4E0D\u6765\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 4
  - question: "\u8D77\u706B\u540E\uFF0C\u8EB2\u8FDB\u4E0B\u9762\u54EA\u4E2A\u4F4D\u7F6E\u6700\u4E0D\u53EF\u53D6\uFF1F"
    optionA: "\u6709\u5916\u7A97\u7684\u623F\u95F4\uFF0C\u5173\u7D27\u95E8\u7A97\u3001\u7A97\u53E3\u547C\u6551"
    optionB: "\u8863\u67DC\u3001\u5E8A\u5E95\u7B49\u9690\u853D\u5904"
    optionC: "\u9760\u8FD1\u4E3B\u5E72\u9053\u623F\u95F4\u7684\u4F4E\u59FF\u5904"
    correctIndex: 1
    explanation: "\u8EB2\u8FDB\u8863\u67DC\u5E8A\u5E95\u7B49\u4E8E\u81EA\u65AD\u547C\u6551\u4E0E\u9003\u751F\u8DEF\u5F84\uFF0C\u641C\u6551\u4EBA\u5458\u4E5F\u96BE\u53D1\u73B0\uFF1B\u56FA\u5B88\u5F85\u63F4\u8981\u9009\u6709\u7A97\u3001\u4E34\u8857\u7684\u623F\u95F4\u5E76\u6301\u7EED\u547C\u6551\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 4
  - question: "\u9AD8\u5C42\u5EFA\u7B51\u53D1\u751F\u706B\u707E\uFF0C\u4E0B\u9762\u54EA\u79CD\u9009\u62E9\u6700\u5371\u9669\uFF1F"
    optionA: "\u6CBF\u758F\u6563\u697C\u68AF\u5411\u4E0B\u64A4\u79BB"
    optionB: "\u76F2\u76EE\u8DF3\u697C\u9003\u751F"
    optionC: "\u697C\u68AF\u88AB\u5C01\u65F6\u9000\u56DE\u623F\u95F4\u56FA\u5B88\u5F85\u63F4"
    correctIndex: 1
    explanation: "\u4E09\u5C42\u4EE5\u4E0A\u8DF3\u697C\u751F\u8FD8\u7387\u6781\u4F4E\uFF1B\u9003\u4E0D\u51FA\u53BB\u65F6\u9000\u5B88\u623F\u95F4\u3001\u5835\u7F1D\u6CFC\u6C34\u3001\u7A97\u53E3\u547C\u6551\u624D\u662F\u6B63\u786E\u9009\u62E9\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 4
  - question: "\u5173\u4E8E\u201C\u62AB\u6E7F\u68C9\u88AB\u51B2\u8FC7\u706B\u573A\u201D\u8FD9\u79CD\u505A\u6CD5\uFF0C\u6B63\u786E\u8BA4\u8BC6\u662F\uFF1F"
    optionA: "\u53EA\u662F\u8FEB\u4E0D\u5F97\u5DF2\u65F6\u7684\u6700\u540E\u624B\u6BB5\uFF0C\u4E14\u5FC5\u987B\u914D\u5408\u4F4E\u59FF\u3001\u5FEB\u901F\u901A\u8FC7"
    optionB: "\u662F\u706B\u573A\u9003\u751F\u7684\u9996\u9009\u65B9\u6CD5"
    optionC: "\u5E72\u68C9\u88AB\u6BD4\u6E7F\u68C9\u88AB\u66F4\u8010\u706B"
    correctIndex: 0
    explanation: "\u6E7F\u68C9\u88AB\u80FD\u77ED\u6682\u9694\u70ED\uFF0C\u4F46\u6D53\u70DF\u6BD2\u6C14\u624D\u662F\u6700\u5927\u5A01\u80C1\uFF1B\u6B63\u5E38\u60C5\u51B5\u6CBF\u758F\u6563\u8DEF\u7EBF\u64A4\u79BB\uFF0C\u4EC5\u5728\u5C0F\u901A\u9053\u88AB\u77ED\u6682\u5C01\u5835\u7B49\u8FEB\u4E0D\u5F97\u5DF2\u65F6\u4F7F\u7528\u3002"
    illustration: {fileID: 0}
    scienceCategoryIndex: 4
  roundSize: 10
