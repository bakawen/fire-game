    prompt: "\u7535\u8BDD\u63A5\u901A\u3002\u63A5\u7EBF\u5458\uFF1A\u201C\u4F60\u597D\uFF0C119\u3002\u8BF7\u8BB2\u3002\u201D\n\u4F60\u7B2C\u4E00\u53E5\u5E94\u8BE5\u8BF4\u4EC0\u4E48\uFF1F"
