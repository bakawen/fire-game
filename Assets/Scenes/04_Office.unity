    objective: "\u2460 \u6309\u4E0B\u624B\u52A8\u706B\u707E\u62A5\u8B66\u6309\u94AE\uFF08\u4F1A\u8BAE\u533A\u73BB\u7483\u9694\u65AD\xB7\u7EA2\u8272\u6807\u8BB0\uFF09"
    hint: "\u8B66\u62A5\u5DF2\u89E6\u53D1\uFF0C\u5168\u697C\u8FDB\u5165\u758F\u6563\u72B6\u6001\uFF01\u7535\u6C14\u8D77\u706B\u5E94\u5148\u65AD\u7535\u2014\u2014\u5230\u4E1C\u4FA7\u7535\u7BB1\u6309
      E \u62C9\u95F8"
  - source: 2
    objective: "\u2461 \u62C9\u4E0B\u914D\u7535\u7BB1\u7535\u95F8\u65AD\u7535\uFF08\u9EC4\u8272\u6807\u8BB0\uFF09"
    hint: "\u5DF2\u65AD\u7535\uFF0C\u706B\u6E90\u5F00\u59CB\u8870\u51CF\uFF01\u6309
      E \u6253\u788E\u6D88\u9632\u67DC\u73BB\u7483\u53D6\u51FA\u706D\u706B\u5668\uFF0C\u5BF9\u51C6\u706B\u7130\u6839\u90E8\u6309\u4F4F\u5DE6\u952E\u55B7\u5C04"
  - source: 3
    objective: "\u2462 \u6253\u788E\u6D88\u9632\u67DC\u53D6\u51FA\u706D\u706B\u5668\uFF08\u6A59\u8272\u6807\u8BB0\uFF09"
    hint: "\u706D\u706B\u5668\u5728\u624B\uFF08\u6309\u4F4F\u5DE6\u952E\u55B7\u5C04\uFF09\uFF01\u6CE8\u610F\u5242\u91CF\u6709\u9650\uFF0C\u6251\u4E0D\u706D\u7684\u5927\u706B\u4E0D\u8981\u604B\u6218"
  - source: 4
    objective: "\u2463 \u5BF9\u51C6\u706B\u7130\u6839\u90E8\u6309\u4F4F\u5DE6\u952E\uFF0C\u6251\u706D\u5DE5\u4F4D\u706B"
    hint: "\u521D\u671F\u706B\u5DF2\u63A7\u5236\uFF01\u706B\u52BF\u4ECD\u5728\u8513\u5EF6\u2014\u2014\u6CBF\u7EFF\u8272\u758F\u6563\u6307\u793A\u5411\u5317\u64A4\u79BB"
  - source: 5
    objective: "\u2464 \u5230\u524D\u53F0\u63A5\u5F85\u53F0\u62FF\u6E7F\u6BDB\u5DFE\uFF08\u9752\u8272\u6807\u8BB0\uFF09"
    hint: "\u6E7F\u6BDB\u5DFE\u5DF2\u6342\u4F4F\u53E3\u9F3B\uFF0C\u6D53\u70DF\u4F24\u5BB3\u5927\u5E45\u964D\u4F4E\u3002\u8DDF\u968F\u7EFF\u8272\u5B89\u5168\u51FA\u53E3\u6307\u793A\u4F4E\u59FF\u524D\u884C"
  - source: 6
    objective: "\u2465 \u8E72\u4E0B\u4F4E\u59FF\u7A7F\u8FC7\u6D53\u70DF\u8D70\u5ECA\uFF0C\u5230\u9632\u706B\u95E8\u7B54\u9898"
    hint: "\u56DE\u7B54\u6B63\u786E\uFF0C\u9632\u706B\u95E8\u5DF2\u5F00\u542F\uFF01\u7A7F\u8FC7\u524D\u5385\uFF0C\u6CBF\u7EFF\u8272\u6307\u793A\u4ECE\u4E3B\u5165\u53E3\u64A4\u79BB"
  - source: 0
    objective: "\u2466 \u7A7F\u8FC7\u524D\u5385\uFF0C\u4ECE\u4E3B\u5165\u53E3\u64A4\u79BB\uFF08\u7EFF\u8272\u6807\u8BB0\uFF09"
    hint: 
  crawlHint: "\u6D53\u70DF\u5DF2\u6F2B\u8FC7\u5934\u9876\uFF01\u7ACB\u5373\u6309\u4F4F
    Ctrl \u8E72\u4E0B\uFF0C\u4F4E\u59FF\u901A\u8FC7\u6D53\u70DF\u533A"
  elevatorHint: "\u505C\u7535\u88AB\u56F0\u5728\u7535\u68AF\u91CC\u4E86\uFF01\u706B\u573A\u4E25\u7981\u4E58\u7535\u68AF\u2014\u2014\u95E8\u5F00\u540E\u6CBF\u7EFF\u8272\u6307\u793A\u4ECE\u524D\u5385\u4E3B\u5165\u53E3\u64A4\u79BB"
